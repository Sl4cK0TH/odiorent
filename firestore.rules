rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // USERS COLLECTION
    match /users/{userId} {
      // Allow anyone to read user profiles. 
      // This is REQUIRED for the "Login by Username" feature to work, 
      // as the app needs to query the 'users' collection to find the email before the user is logged in.
      allow read: if true;
      
      // Only the user themselves can update their profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // PROPERTIES COLLECTION (Publicly visible)
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null; // Restrict to Landlords/Admins in logic
    }
    
    // CHATS & MESSAGES (Private)
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants);
        
       match /messages/{messageId} {
         allow read, write: if request.auth != null;
       }
    }

    // DEFAULT: Deny everything else unless logged in
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
